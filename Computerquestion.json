      "subject": "Mathematics",
      "class": "12",
      "semester": "3",
      "question": "Solve: 2x + 5 = 15.",
      "options": [
        "3",
        "5",
        "7",
        "10"
      ],
      "answer": "5",
      "solution": "2x + 5 = 15 → 2x = 10 → x = 5.",
