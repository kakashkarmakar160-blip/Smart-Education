    {
      "id": "cmath-001",
      "type": "math",
      "subject": "Mathematics",
      "class": "12",
      "semester": "3",
      "question": "If A's Old Ratio is 1/2 and New Ratio is 1/3, calculate A's sacrifice.",
      "options": [
        "1/6",
        "1/3",
        "1/2",
        "2/3"
      ],
      "answer": "1/6",
      "solution": "Sacrifice = Old Ratio − New Ratio = 1/2 − 1/3 = 1/6.",
      "marks": 1,
      "topic": ""
    },
    {
      "id": "cmath-002",
